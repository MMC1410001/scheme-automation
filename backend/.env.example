# ---- Server ----
PORT=3000

# ---- Google Cloud auth ----
# Either point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key file,
# or supply the three values below directly. Never commit real credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
project_id=your-gcp-project-id
client_email=your-service-account@your-project.iam.gserviceaccount.com
private_key="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Google Cloud Storage ----
GCP_BUCKET_NAME=your-gcs-bucket

# ---- BigQuery (used for column-schema validation) ----
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=your_dataset_id
# Optional: override the slot -> BigQuery table mapping per environment
BQ_TABLE_MAP_JSON={"incentive_scheme_sku":"incentive_scheme_sku","category_b_sku":"category_b_sku","contractor_loyalty":"contractor_loyalty","sales_system_export":"sales_system_export","mapping_of_franchise":"mapping_of_franchise","working_file":"working_file","parent_child":"parent_child","missed_inbill":"missed_inbill","scheme_mapping":"scheme_mapping"}

# ---- Cloud Run automation targets ----
# The two downstream jobs this app triggers. Required for POST /api/run-process.
CLOUD_RUN_URL_NORMAL=https://your-normal-job-xxxxxxxx.region.run.app
CLOUD_RUN_URL_REVISED=https://your-revised-job-xxxxxxxx.region.run.app
RUN_ID_NORMAL=normal_run
RUN_ID_REVISED=revised_run

# ---- Email notifications (Gmail SMTP) ----
EMAIL_USERNAME=your-sender@example.com
EMAIL_APP_PASS=your-app-password
EMAIL_TO=recipient-one@example.com,recipient-two@example.com

# ---- Shared secret used to obfuscate the frontend API URL ----
CONFIG_PASSWORD=choose-a-passphrase
