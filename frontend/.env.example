# Local full-stack development (npm run dev:local)
# Leave VITE_API_URL unset so the app calls "/api" and Vite proxies it to
# http://localhost:3000 — see vite.config.local.ts.
# VITE_API_URL=

# Shared passphrase used to decrypt VITE_API_URL when it is set.
# NOTE: anything prefixed VITE_ is inlined into the client bundle and is
# therefore public. This is obfuscation, not encryption.
VITE_CONFIG_PASSWORD=choose-a-passphrase
